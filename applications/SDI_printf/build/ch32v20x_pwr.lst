 260              	/*********************************************************************
 261              	 * @fn      NVIC_SetPriority
 262              	 *
 263              	 * @brief   Set Interrupt Priority
 264              	 *
 265              	 * @param   IRQn - Interrupt Numbers
 266              	 *          interrupt nesting enable(CSR-0x804 bit1 = 1)
 267              	 *            priority - bit[7] - Preemption Priority
 268              	 *                       bit[6:5] - Sub priority
 269              	 *                       bit[4:0] - Reserve
 270              	 *          interrupt nesting disable(CSR-0x804 bit1 = 0)
 271              	 *            priority - bit[7:5] - Sub priority
 272              	 *                       bit[4:0] - Reserve
 273              	 *
 274              	 * @return  none
 275              	 */
 276              	__attribute__( ( always_inline ) ) RV_STATIC_INLINE void NVIC_SetPriority(IRQn_Type IRQn, uint8_t p
 277              	{
 278              	  NVIC->IPRIOR[(uint32_t)(IRQn)] = priority;
 279              	}
