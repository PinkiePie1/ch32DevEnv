 159              	/*********************************************************************
 160              	 * @fn      NVIC_EnableIRQ
 161              	 *
 162              	 * @brief   Enable Interrupt
 163              	 *
 164              	 * @param   IRQn - Interrupt Numbers
 165              	 *
 166              	 * @return  none
 167              	 */
 168              	__attribute__( ( always_inline ) ) RV_STATIC_INLINE void NVIC_EnableIRQ(IRQn_Type IRQn)
 169              	{
 170              	  NVIC->IENR[((uint32_t)(IRQn) >> 5)] = (1 << ((uint32_t)(IRQn) & 0x1F));
 171              	}
 172              	
 173              	/*********************************************************************
 174              	 * @fn      NVIC_DisableIRQ
 175              	 *
 176              	 * @brief   Disable Interrupt
 177              	 *
 178              	 * @param   IRQn - Interrupt Numbers
 179              	 *
 180              	 * @return  none
 181              	 */
 182              	__attribute__( ( always_inline ) ) RV_STATIC_INLINE void NVIC_DisableIRQ(IRQn_Type IRQn)
 183              	{
 184              	  NVIC->IRER[((uint32_t)(IRQn) >> 5)] = (1 << ((uint32_t)(IRQn) & 0x1F));
 185              	}
 186              	
 187              	/*********************************************************************
 188              	 * @fn      NVIC_GetStatusIRQ
 189              	 *
 190              	 * @brief   Get Interrupt Enable State
 191              	 *
GAS LISTING /tmp/ccpKfpAG.s 			page 6


 192              	 * @param   IRQn - Interrupt Numbers
 193              	 *
 194              	 * @return  1 - Interrupt Pending Enable
 195              	 *          0 - Interrupt Pending Disable
 196              	 */
 197              	__attribute__( ( always_inline ) ) RV_STATIC_INLINE uint32_t NVIC_GetStatusIRQ(IRQn_Type IRQn)
 198              	{
 199              	  return((uint32_t) ((NVIC->ISR[(uint32_t)(IRQn) >> 5] & (1 << ((uint32_t)(IRQn) & 0x1F)))?1:0));
 200              	}
 201              	
