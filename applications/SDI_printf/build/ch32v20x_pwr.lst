 123              	/*********************************************************************
 124              	 * @fn      __enable_irq
 125              	 *
 126              	 * @brief   Enable Global Interrupt
 127              	 *
 128              	 * @return  none
 129              	 */
 130              	__attribute__( ( always_inline ) ) RV_STATIC_INLINE void __enable_irq()
 131              	{
 132              	  __asm volatile ("csrs 0x800, %0" : : "r" (0x88) );
 133              	}
 134              	
GAS LISTING /tmp/ccpKfpAG.s 			page 5


 135              	/*********************************************************************
 136              	 * @fn      __disable_irq
 137              	 *
 138              	 * @brief   Disable Global Interrupt
 139              	 *
 140              	 * @return  none
 141              	 */
 142              	__attribute__( ( always_inline ) ) RV_STATIC_INLINE void __disable_irq()
 143              	{
 144              	  __asm volatile ("csrc 0x800, %0" : : "r" (0x88) );
 145              	}
